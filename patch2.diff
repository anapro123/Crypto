+    @staticmethod
+    def _top_of_book_notional(order_book: NormalizedOrderBook, side: str, levels: int = 5) -> float:
+        """Estimate quote-currency notional at the top of the book."""
+        book = order_book.asks if side == "ask" else order_book.bids
+        total = 0.0
+        for level in book[:levels]:
+            if level.price > 0 and level.amount > 0:
+                total += level.price * level.amount
+        return total
+
+    def _estimate_liquidity(
+        self,
+        order_book: NormalizedOrderBook,
+        side: str,
+        reference_price: float,
+        tolerance_pct: float = 0.25,
+        levels: int = 5,
+    ) -> float:
+        """
+        Try a tight price window first; if that returns zero, fall back to
+        the top-of-book notional to avoid treating a valid book as empty.
+        """
+        liquidity = order_book.get_liquidity_at_price(reference_price, side, tolerance_pct)
+        if liquidity <= 0:
+            liquidity = self._top_of_book_notional(order_book, side, levels)
+        return liquidity
+
+    def _path_liquidity(
+        self,
+        symbols: Dict[str, NormalizedOrderBook],
+        graph: nx.DiGraph,
+        path: List[str],
+    ) -> float:
+        """Estimate the minimum notional liquidity across all legs of a route."""
+        route_liquidity = None
+
+        for i in range(len(path) - 1):
+            from_curr = path[i]
+            to_curr = path[i + 1]
+            edge_data = graph[from_curr][to_curr]
+            symbol = edge_data["symbol"]
+            ob = symbols.get(symbol)
+            if not ob:
+                continue
+
+            reference_price = ob.best_ask if edge_data["side"] == "buy" else ob.best_bid
+            if not reference_price:
+                continue
+
+            leg_liquidity = self._estimate_liquidity(
+                ob,
+                edge_data["side"],
+                reference_price,
+                tolerance_pct=0.25,
+            )
+            if leg_liquidity > 0:
+                route_liquidity = leg_liquidity if route_liquidity is None else min(route_liquidity, leg_liquidity)
+
+        return route_liquidity or 0.0
